{
  "entities": {
    "Config": {
      "title": "Brand Configuration",
      "description": "White label branding configuration for generating links.",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "description": "The name of the brand" },
        "brandTagline": { "type": "string", "description": "The brand tagline" },
        "brandLogo": { "type": "string", "description": "Base64 encoded logo image" },
        "whatsapp": { "type": "string", "description": "WhatsApp contact number" },
        "doubtMsg": { "type": "string", "description": "Default doubt message for parents" }
      },
      "required": ["brandName"]
    },
    "Registration": {
      "title": "Student Registration",
      "description": "Form answers completed by parents for student onboarding.",
      "type": "object",
      "properties": {
        "configId": { "type": "string", "description": "Reference to the brand configuration used" },
        "name": { "type": "string", "description": "Student full name" },
        "nickname": { "type": "string" },
        "birthday": { "type": "string" },
        "age": { "type": "string" },
        "school": { "type": "string" },
        "grade": { "type": "string" },
        "guardianNameRelation": { "type": "string" },
        "phone": { "type": "string" },
        "photo": { "type": "string" },
        "diagnosis": { "type": "string" },
        "professionals": { "type": "string" },
        "medications": { "type": "string" },
        "communicationMethod": { "type": "string" },
        "communicationOtherDesc": { "type": "string" },
        "comprehension": { "type": "string" },
        "sensorialSounds": { "type": "array" },
        "sensorialLights": { "type": "array" },
        "sensorialTouch": { "type": "array" },
        "sensorialMovement": { "type": "array" },
        "sensorialNotes": { "type": "string" },
        "emotionalReaction": { "type": "string" },
        "emotionalTriggers": { "type": "string" },
        "emotionalCalming": { "type": "string" },
        "emotionalWhatToAvoid": { "type": "string" },
        "routineType": { "type": "string" },
        "routineChanges": { "type": "string" },
        "foodRestrictions": { "type": "string" },
        "sleepDifficulties": { "type": "string" },
        "favoriteSubjects": { "type": "string" },
        "favoriteToys": { "type": "string" },
        "biggestDifficulties": { "type": "string" },
        "peerRelationship": { "type": "string" },
        "authorityRelationship": { "type": "string" },
        "schoolAdaptations": { "type": "string" },
        "schoolChallenges": { "type": "string" },
        "additionalInfo": { "type": "string" },
        "fillDate": { "type": "string" },
        "guardianSignature": { "type": "string" }
      },
      "required": ["name", "birthday", "age", "guardianNameRelation", "phone"]
    },
    "AdminSettings": {
      "title": "Admin Settings",
      "description": "Global settings for the admin panel, including authorization passwords.",
      "type": "object",
      "properties": {
        "password": { "type": "string", "description": "Admin panel access password" }
      },
      "required": ["password"]
    }
  },
  "firestore": {
    "configs/{configId}": {
      "schema": "Config",
      "description": "Dynamic configurations generated by administrators"
    },
    "registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Student registration forms filled out by parents"
    },
    "admin/settings": {
      "schema": "AdminSettings",
      "description": "Global system configurations"
    }
  }
}
